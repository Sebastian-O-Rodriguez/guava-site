---
export interface Props {
  title?: string;
}
import '../styles/global.css';
const { title = "Tech Consultancy | Business Solutions" } = Astro.props;
---
<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Define CSS variables for theme and mobile menu -->
    <style is:global>
      :root {
        /* Colors */
        --color-background: #FEFEFE;
        --color-text: #2C2828;
        --color-accent: #39FF14;
        --color-accent-two: #187B43;
        --color-secondary: #2C2828;
        
        /* Color variants */
        --color-background-alt: #F5F5F5;
        --color-text-muted: rgba(44, 40, 40, 0.7);
        --color-accent-subtle: rgba(57, 255, 20, 0.15);
        --color-accent-two-subtle: rgba(24, 123, 67, 0.15);
        
        /* UI Elements */
        --header-height: 4rem;
      }
      
      /* Selection styling */
      ::selection {
        background-color: var(--color-accent-two);
        color: white;
      }
      
      /* Add transitions to the hamburger button spans */
      #hamburger-button span:not(.sr-only) {
        @apply transition-all duration-300 ease-in-out;
      }
    </style>
  </head>
  <body class="bg-background text-text m-0 p-0 min-h-screen font-sans leading-normal">
    <main class="w-full min-h-screen">
      <slot />
    </main>
  </body>
</html>