---
---
<section id="case-studies" class="section-wrapper">
  <div class="container">
    <div class="content-container">
      <h1 class="section-header">Case Studies</h1>
    
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-md mt-lg mb-xl">
        <div class="card overflow-hidden h-full">
          <div class="p-lg">
            <div class="flex gap-md mb-md items-center">
              <div class="flex-shrink-0">
                <div class="w-[70px] h-[70px] bg-text/10 rounded-lg flex items-center justify-center text-small text-text/30 border border-dashed border-text/20">
                  Client Logo
                </div>
              </div>
              <div>
                <h3 class="text-large font-semibold mb-xs text-text">Enterprise Cloud Migration</h3>
                <p class="text-large font-medium m-0 text-text">Financial Services Company</p>
              </div>
            </div>
            
            <div>
              <p class="mb-sm leading-normal text-text/80"><strong class="text-text">Challenge:</strong> Legacy infrastructure causing reliability issues and increasing maintenance costs.</p>
              <p class="mb-sm leading-normal text-text/80"><strong class="text-text">Solution:</strong> Designed and implemented a phased cloud migration strategy with minimal disruption to daily operations.</p>
              <p class="leading-normal text-text/80"><strong class="text-text">Result:</strong> 40% reduction in operational costs and 99.9% system uptime with improved disaster recovery capabilities.</p>
            </div>
          </div>
        </div>
        
        <div class="card overflow-hidden h-full">
          <div class="p-lg">
            <div class="flex gap-md mb-md items-center">
              <div class="flex-shrink-0">
                <div class="w-[70px] h-[70px] bg-text/10 rounded-lg flex items-center justify-center text-small text-text/30 border border-dashed border-text/20">
                  Client Logo
                </div>
              </div>
              <div>
                <h3 class="text-large font-semibold mb-xs text-text">Custom CRM Development</h3>
                <p class="text-large font-medium m-0 text-text">Healthcare Provider</p>
              </div>
            </div>
            
            <div>
              <p class="mb-sm leading-normal text-text/80"><strong class="text-text">Challenge:</strong> Off-the-shelf solutions failed to meet specialized patient management requirements.</p>
              <p class="mb-sm leading-normal text-text/80"><strong class="text-text">Solution:</strong> Built a tailored CRM system with integrated scheduling and HIPAA-compliant data management.</p>
              <p class="leading-normal text-text/80"><strong class="text-text">Result:</strong> 30% increase in staff efficiency and improved patient satisfaction scores.</p>
            </div>
          </div>
        </div>
        
        <div class="card overflow-hidden h-full">
          <div class="p-lg">
            <div class="flex gap-md mb-md items-center">
              <div class="flex-shrink-0">
                <div class="w-[70px] h-[70px] bg-text/10 rounded-lg flex items-center justify-center text-small text-text/30 border border-dashed border-text/20">
                  Client Logo
                </div>
              </div>
              <div>
                <h3 class="text-large font-semibold mb-xs text-text">E-commerce Platform Optimization</h3>
                <p class="text-large font-medium m-0 text-text">Retail Brand</p>
              </div>
            </div>
            
            <div>
              <p class="mb-sm leading-normal text-text/80"><strong class="text-text">Challenge:</strong> Slow-loading pages and poor mobile experience leading to high cart abandonment rates.</p>
              <p class="mb-sm leading-normal text-text/80"><strong class="text-text">Solution:</strong> Comprehensive front-end optimization and responsive redesign with improved checkout flow.</p>
              <p class="leading-normal text-text/80"><strong class="text-text">Result:</strong> 65% faster page load times and 28% increase in mobile conversion rates.</p>
            </div>
          </div>
        </div>
      </div>
      
      <h3 class="text-h3 font-semibold mb-lg text-center text-text">What Our Clients Say</h3>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-md">
        <!-- Testimonial Card 1: Fixed padding and quote positioning -->
        <div class="card relative">
          <!-- Quote icon with better positioning -->
          <div class="absolute top-6 right-6 text-text/20">
            <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"></path>
              <path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"></path>
            </svg>
          </div>
          
          <!-- Content with proper padding to avoid overlap -->
          <div class="p-lg pr-16"> <!-- Added extra padding on the right -->
            <blockquote class="text-large italic leading-normal mb-md text-text/80">
              "Their team's technical expertise and strategic approach helped us overcome complex challenges and deliver our project ahead of schedule. The results have exceeded our expectations."
            </blockquote>
            <div class="border-t border-text/10 pt-sm">
              <p class="font-semibold mb-xs text-text">Jane Smith</p>
              <p class="text-small text-text/70 m-0">CTO, Technology Solutions Inc.</p>
            </div>
          </div>
        </div>
        
        <!-- Testimonial Card 2: Fixed padding and quote positioning -->
        <div class="card relative">
          <!-- Quote icon with better positioning -->
          <div class="absolute top-6 right-6 text-text/20">
            <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"></path>
              <path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"></path>
            </svg>
          </div>
          
          <!-- Content with proper padding to avoid overlap -->
          <div class="p-lg pr-16"> <!-- Added extra padding on the right -->
            <blockquote class="text-large italic leading-normal mb-md text-text/80">
              "What sets this consultancy apart is their ability to translate complex technical concepts into business value. They're not just implementing technology—they're solving real business problems."
            </blockquote>
            <div class="border-t border-text/10 pt-sm">
              <p class="font-semibold mb-xs text-text">Robert Johnson</p>
              <p class="text-small text-text/70 m-0">CEO, Global Retail Group</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>