    <div class="rounded-lg border border-text/10 bg-white/5 p-md">
      <h3 class="text-h3 mb-xs">Backroom Automation</h3>
      <p class="text-sm text-muted">Placeholder wedge body.</p>
    </div>
    <div class="rounded-lg border border-text/10 bg-white/5 p-md">
      <h3 class="text-h3 mb-xs">Inventory Intelligence / Guava BI</h3>
      <p class="text-sm text-muted">Placeholder wedge body.</p>
    </div>
  </div>
</Section>