---
import Section from '../Section.astro';

// PROOF-04: no customer or integration logos ship here — logos are added only
// with explicit permission. This section carries the two owner-supplied
// outcomes as text, verbatim, with only the metric phrase emphasized.
interface Proof {
  /** Verbatim text before the emphasized metric. */
  lead: string;
  /** The emphasized metric phrase (verbatim). */
  metric: string;
  /** Verbatim text after the emphasized metric. */
  tail: string;
  /** Owner-supplied industry attribution. */
  attribution: string;
}

const proofs: Proof[] = [
  {
    lead: '',
    metric: '30 hours a week',
    tail: ' of data reconciliation removed. 3 data streams reconciled and reported in a sync-enabled dashboard.',
    attribution: 'Property management',
  },
  {
    lead: 'Took ',
    metric: '250k+ records',
    tail: ' from excel-only reporting to automated real time reporting.',
    attribution: 'Financial services',
  },
];
---

<Section variant="white" id="proof" label="Proof" class="py-lg">
  <div class="border-b border-text/10 pb-md" data-proof-carousel>
    <div class="overflow-hidden">
      <div
        class="flex transition-transform duration-slow ease-out-expo motion-reduce:transition-none will-change-transform"
        data-proof-track
      >
        {proofs.map((proof, i) => (
          <figure
            class="flex w-full shrink-0 flex-col gap-sm"
            data-proof-slide
            role="group"
            aria-roledescription="slide"
            aria-label={`${i + 1} of ${proofs.length}`}
            aria-hidden={i === 0 ? 'false' : 'true'}
          >
            <blockquote class="text-large text-text">
              <p>{proof.lead}<span class="font-bold text-brand">{proof.metric}</span>{proof.tail}</p>
            </blockquote>
            <figcaption class="self-end text-sm font-semibold uppercase tracking-wider text-muted">
              {proof.attribution}
            </figcaption>
          </figure>
        ))}
      </div>
    </div>

    <div class="mt-sm flex items-center gap-xs" role="group" aria-label="Proof selection">
      {proofs.map((proof, i) => (
        <button
          type="button"
          data-proof-dot
          aria-pressed={i === 0 ? 'true' : 'false'}
          aria-label={`Show proof: ${proof.attribution}`}
          class="h-2 w-2 rounded-full bg-text/20 transition-colors duration-base hover:bg-text/40 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand aria-pressed:bg-brand"
        ></button>
      ))}
    </div>
  </div>
</Section>

<script>
  const INTERVAL_MS = 6000;

  function init() {
    const root = document.querySelector('[data-proof-carousel]');
    if (!root) return;

    const track = root.querySelector('[data-proof-track]');
    const slides = Array.from(root.querySelectorAll('[data-proof-slide]'));
    const dots = Array.from(root.querySelectorAll('[data-proof-dot]'));
    const controls = root.querySelector('[role="group"][aria-label="Proof selection"]');
    if (!track || slides.length < 2) return;

    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let current = 0;
    let timer = null;
    let paused = false;

    const reduced = () => motion.matches;

    const stop = () => {
      if (timer !== null) {
        clearInterval(timer);
        timer = null;
      }
    };

    const render = (index) => {
      current = ((index % slides.length) + slides.length) % slides.length;
      track.style.transform = `translate3d(-${current * 100}%, 0, 0)`;
      slides.forEach((slide, i) => {
        slide.setAttribute('aria-hidden', String(i !== current));
      });
      dots.forEach((dot, i) => {
        const active = i === current;
        dot.setAttribute('aria-pressed', String(active));
        dot.tabIndex = active ? 0 : -1;
      });
    };

    const start = () => {
      if (reduced() || paused || document.hidden) return;
      stop();
      timer = setInterval(() => render(current + 1), INTERVAL_MS);
    };

    const select = (index) => {
      render(index);
      start();
    };

    dots.forEach((dot, i) => {
      dot.tabIndex = i === 0 ? 0 : -1;
      dot.addEventListener('click', () => select(i));
    });

    if (controls) {
      controls.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
        event.preventDefault();
        select(current + (event.key === 'ArrowRight' ? 1 : -1));
        dots[current]?.focus();
      });
    }

    // Pause auto-rotation while the pointer hovers or focus sits inside.
    root.addEventListener('mouseenter', () => {
      paused = true;
      stop();
    });
    root.addEventListener('mouseleave', () => {
      paused = false;
      start();
    });
    root.addEventListener('focusin', () => {
      paused = true;
      stop();
    });
    root.addEventListener('focusout', () => {
      if (!root.contains(document.activeElement)) {
        paused = false;
        start();
      }
    });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else start();
    });

    motion.addEventListener('change', () => {
      stop();
      start();
    });

    render(0);
    start();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init, { once: true });
  } else {
    init();
  }
</script>