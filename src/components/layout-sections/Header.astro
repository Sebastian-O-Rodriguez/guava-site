---
import Button from '../Button.astro';
import HeaderNav from './HeaderNav.svelte';
---

<header class="sticky top-0 z-50 w-full bg-background/95 backdrop-blur-md border-b border-text/10">
  <div class="container flex items-center justify-between h-16 md:h-20">
    <a href="/" class="flex items-center gap-sm shrink-0" aria-label="Guava AI — Home">
      <img src="/brand/guava-logo-colored.svg" alt="" class="h-8 w-auto md:h-9" />
      <span class="text-lg font-bold tracking-tight text-text">Guava&nbsp;AI</span>
    </a>

    <HeaderNav client:visible />

    <div class="hidden lg:block ml-md">
      <Button variant="primary" href="/book-a-demo">Book a Demo</Button>
    </div>
  </div>
</header>