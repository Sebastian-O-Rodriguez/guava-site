---
const groups = [
  {
    title: 'Solutions',
    links: [
      { label: 'Operations Automation', href: '/operations-automation' },
      { label: 'Guava BI', href: '/guava-bi' },
    ],
  },
  {
    title: 'Company',
    links: [
      { label: 'About', href: '/about' },
      { label: 'Industries', href: '/industries' },
      { label: 'Contact', href: '/talk-to-guava' },
    ],
  },
  {
    title: 'Resources',
    links: [{ label: 'Insights', href: '/insights' }],
  },
];
---

<footer class="section-band section-band--brand">
  <div class="container">
    <div class="pb-lg mb-lg border-b border-white/20">
      <a href="/" class="inline-flex items-center gap-sm" aria-label="Guava AI Home">
        <span class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-white">
          <img src="/brand/guava-logo-colored.svg" alt="" class="h-6 w-auto" />
        </span>
        <span class="text-lg font-bold tracking-tight text-white">Guava&nbsp;AI</span>
      </a>
    </div>

    <nav class="grid grid-cols-2 md:grid-cols-3 gap-md gap-y-lg" aria-label="Footer">
      {groups.map((group) => (
        <div>
          <h3 class="text-sm font-semibold text-white mb-sm">{group.title}</h3>
          <ul class="list-none p-0 space-y-xs">
            {group.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-white transition-colors duration-fast hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white rounded-sm"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>

    <div class="border-t border-white/20 mt-lg pt-md">
      <p class="text-sm text-white/85">&copy; 2026 Guava Artificial Intelligence, Ltd.</p>
    </div>
  </div>
</footer>