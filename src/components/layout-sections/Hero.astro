---
import Section from '../Section.astro';
import Button from '../Button.astro';
---

<Section variant="white" id="hero">
  <h1 class="text-h1 mb-md max-w-3xl">
    Your business has outgrown the way it operates.
  </h1>
  <p class="text-large text-muted max-w-2xl mb-lg">
    Guava builds practical systems that reduce manual work, improve visibility,
    and help your operation scale without multiplying complexity.
  </p>
  <div class="flex flex-wrap gap-md">
    <Button variant="primary" href="/book-a-demo">Book a Demo</Button>
    <Button variant="outline" href="#capability-explorer">Explore Solutions</Button>
  </div>
</Section>