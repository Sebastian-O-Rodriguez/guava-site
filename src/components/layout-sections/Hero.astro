---
import Section from '../Section.astro';
import Button from '../Button.astro';

const industries = ['Retail', 'Distribution', 'Wholesale', 'Grocery', 'Multi-Location'];
---

<Section variant="white" id="hero" class="relative flex flex-col justify-center overflow-hidden min-h-[85vh]">
  <h1 class="relative z-10 text-h1 mb-md max-w-3xl [text-wrap:balance]">
    Building Smarter Systems for{' '}
    <span class="inline-grid justify-items-center" data-hero-words>
      {industries.map((industry, i) => (
        <span
          class:list={[
            'col-start-1 row-start-1 text-center whitespace-nowrap text-brand',
            i !== 0 && 'invisible',
          ]}
          data-hero-word
        >
          {industry}
        </span>
      ))}
    </span>{' '}
    Businesses
  </h1>
  <p class="relative z-10 text-large text-muted max-w-2xl mb-lg">
    Connect data, workflows, and software into pragmatic systems that reduce manual work, improve visibility, and give your team more room to grow.
  </p>

  <div class="relative z-10 flex flex-wrap items-start gap-md">
    <Button variant="primary" href="/book-a-demo">Talk to Guava</Button>
    <Button variant="outline" href="#how-we-work">See How We Work</Button>
  </div>

  <img
    src="/brand/guava-logo-colored.svg"
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute right-0 top-1/2 z-0 -translate-y-1/2 translate-x-0 select-none w-[min(46vw,19rem)] md:w-[min(38vw,24rem)] lg:w-[min(34vw,27rem)] xl:w-[min(42vw,30rem)] max-w-none opacity-40 md:opacity-50 lg:opacity-60 xl:opacity-100"
  />
</Section>

<script>
  import { gsap } from 'gsap';

  // Mirrors M2 motion tokens (tailwind.config.js): duration-base = 250ms,
  // easing out-expo = cubic-bezier(0.16, 1, 0.3, 1) → GSAP expo.out.
  const ROTATE_INTERVAL_MS = 3200;
  const FADE_DURATION = 0.25;
  const FADE_EASE = 'expo.out';

  function init() {
    const root = document.querySelector('[data-hero-words]');
    if (!root) return;

    const words = Array.from(root.querySelectorAll('[data-hero-word]'));
    if (words.length < 2) return;

    let current = 0;
    let timer = null;
    let reduced = false;

    const stop = () => {
      if (timer !== null) {
        clearInterval(timer);
        timer = null;
      }
    };

    const select = (index, fade) => {
      const target = (index + words.length) % words.length;
      if (target === current) return;

      const outgoing = words[current];
      const incoming = words[target];
      current = target;

      // Collapse to a single visible word first so a mid-fade interaction
      // can never leave two hero words stacked.
      gsap.killTweensOf(words);
      words.forEach((word) => {
        gsap.set(word, { autoAlpha: word === outgoing ? 1 : 0 });
      });

      if (!fade) {
        gsap.set(incoming, { autoAlpha: 1 });
        return;
      }

      gsap.to(outgoing, {
        autoAlpha: 0,
        duration: FADE_DURATION,
        ease: FADE_EASE,
        onComplete: () => {
          gsap.set(incoming, { autoAlpha: 0 });
          gsap.to(incoming, {
            autoAlpha: 1,
            duration: FADE_DURATION,
            ease: FADE_EASE,
          });
        },
      });
    };

    const next = () => select(current + 1, !reduced);

    const start = () => {
      if (reduced) return;
      stop();
      timer = setInterval(next, ROTATE_INTERVAL_MS);
    };

    const mm = gsap.matchMedia();
    mm.add('(prefers-reduced-motion: no-preference)', () => {
      reduced = false;
      start();
    });
    mm.add('(prefers-reduced-motion: reduce)', () => {
      reduced = true;
      stop();
      gsap.killTweensOf(words);
      words.forEach((word, i) => {
        gsap.set(word, { autoAlpha: i === current ? 1 : 0 });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init, { once: true });
  } else {
    init();
  }
</script>