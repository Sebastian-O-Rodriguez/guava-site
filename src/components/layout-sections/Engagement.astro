---
import Section from '../Section.astro';

// ENGAGE-01/02/03 — how an engagement starts. Two paths, step names verbatim.
const paths = [
  ['The problem is clear', 'Scope the system', 'Build'],
  ['The problem is complex or uncertain', 'Operational Diagnostic', 'Recommended path'],
];
---

<Section variant="texture-1" id="engagement" label="Engagement">
  <h2 class="text-h2 mb-md max-w-3xl">How an engagement starts.</h2>
  <p class="text-muted max-w-2xl mb-lg">
    Every engagement begins the same way: establishing whether the problem is
    already clear, or whether it needs to be diagnosed before the path is set.
  </p>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-lg">
    {paths.map((steps) => (
      <article class="flex flex-col rounded-lg border border-text/10 bg-white p-lg">
        <ol class="list-none p-0 m-0 flex flex-wrap items-center gap-y-xs gap-x-sm text-body text-text">
          {steps.map((step, i) => (
            <Fragment>
              {i > 0 && (
                <li aria-hidden="true" class="font-semibold text-brand">&rarr;</li>
              )}
              <li class="font-semibold">{step}</li>
            </Fragment>
          ))}
        </ol>
      </article>
    ))}
  </div>
</Section>
