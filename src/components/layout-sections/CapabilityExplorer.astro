---
import Section from '../Section.astro';
import Explorer from './Explorer.svelte';

interface Props {
  items?: {
    id: string;
    label: string;
    visual: string;
    description: string;
    note?: string;
  }[];
  title?: string;
  subcopy?: string;
}

const DEFAULT_ITEMS = [
  {
    id: 'pipelines',
    label: 'Pipelines',
    visual: 'pipelines',
    description:
      'Data moving cleanly from fragmented sources into a unified operational model.',
  },
  {
    id: 'dashboards',
    label: 'Dashboards',
    visual: 'dashboards',
    description: 'Trusted operational metrics and decision-ready reporting.',
  },
  {
    id: 'chat',
    label: 'Chat',
    visual: 'chat',
    description:
      'Natural-language interaction with operational data where useful.',
  },
  {
    id: 'pulse',
    label: 'Pulse',
    visual: 'pulse',
    description:
      'Exceptions, anomalies, risks, and opportunities surfaced automatically.',
  },
  {
    id: 'spotlight',
    label: 'Spotlight',
    visual: 'spotlight',
    description: 'High-priority issues and recommendations requiring attention.',
  },
];

const {
  items = DEFAULT_ITEMS,
  title = 'See It in Action',
  subcopy = 'Select a capability to preview how it appears in a working operation.',
} = Astro.props;
---

<Section variant="texture-2" id="capability-explorer" label="Capabilities">
  <h2 class="text-h2 mb-md">{title}</h2>
  <p class="text-muted max-w-2xl mb-lg">{subcopy}</p>
  <Explorer client:visible idPrefix="capability" label="Capabilities" items={items} />
</Section>