---
import Section from '../Section.astro';
import Explorer from './Explorer.svelte';

const items = [
  {
    id: 'pipelines',
    label: 'Pipelines',
    visual: 'pipeline-flow',
    description:
      'POS, ERP, and CSV sources unified into one operational model that feeds reporting and applications.',
  },
  {
    id: 'automation',
    label: 'Automation',
    visual: 'automation-flow',
    description:
      'Documents in, validated, processed, systems updated, with exceptions routed to a person.',
  },
  {
    id: 'decision',
    label: 'Decisions',
    visual: 'decision-loop',
    description:
      'Signals detected, context assembled, a decision made, and the system updated.',
  },
];
---

<Section variant="texture-2" id="capability-explorer" label="Capabilities">
  <h2 class="text-h2 mb-md">How the systems work</h2>
  <p class="text-muted max-w-2xl mb-lg">A few examples of operational work moving through connected systems.</p>
  <Explorer client:visible idPrefix="capability" label="Capabilities" items={items} />
</Section>