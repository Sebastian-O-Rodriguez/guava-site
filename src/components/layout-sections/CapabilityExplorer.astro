---
import Section from '../Section.astro';
---

<Section variant="texture-1" id="capability-explorer">
  <h2 class="text-h2 mb-md">Capability Explorer</h2>
  <p class="text-muted max-w-2xl mb-lg">
    Placeholder body&nbsp;&mdash; technical capability without reading like a
    feature catalog.
  </p>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-md">
    <div class="rounded-lg border border-text/10 bg-white/60 p-md">
      <p class="text-sm text-muted">Selectable list placeholder</p>
    </div>
    <div class="rounded-lg border border-text/10 bg-white/60 p-md min-h-[12rem] flex items-center justify-center">
      <p class="text-sm text-muted">Large visual placeholder</p>
    </div>
  </div>
</Section>