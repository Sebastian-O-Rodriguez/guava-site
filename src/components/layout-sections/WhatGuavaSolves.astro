---
import Section from '../Section.astro';
import Explorer from './Explorer.svelte';

const items = [
  {
    id: 'manual-spreadsheets',
    label: 'Manual work in spreadsheets',
    visual: 'automation',
    description:
      'Too much work lives in spreadsheets and manual processes.',
    note:
      'We move repetitive work into systems, so the work runs itself and no longer depends on people.',
  },
  {
    id: 'disconnected-systems',
    label: 'Disconnected systems',
    visual: 'unification',
    description:
      'Teams copy and reconcile data between disconnected systems.',
    note:
      'We connect the sources into one operational foundation, so teams work from the same current data instead of copying it.',
  },
  {
    id: 'late-reporting',
    label: 'Reporting that arrives too late',
    visual: 'reporting',
    description:
      'Reporting arrives after the decision needs to be made.',
    note:
      'We deliver it in real time, so decisions are made with current information, when they matter.',
  },
  {
    id: 'unnoticed-exceptions',
    label: 'Exceptions that go unnoticed',
    visual: 'pulse',
    description:
      'Important exceptions depend on someone noticing them.',
    note:
      'We surface exceptions automatically, so problems are caught before they compound.',
  },
  {
    id: 'no-reliable-view',
    label: 'No reliable view of operations',
    visual: 'dashboards',
    description:
      'Leadership cannot get one reliable view of the operation.',
    note:
      'We give leadership one trusted view, so decisions rely on the same numbers, not competing reports.',
  },
  {
    id: 'software-mismatch',
    label: 'Software that doesn’t fit',
    visual: 'custom',
    description:
      'Existing software does not match how the operation actually works.',
    note:
      'We build systems around how the operation works, so software fits the work instead of forcing work to fit software.',
  },
];
---

<Section variant="texture-2" id="what-guava-solves">
  <h2 class="text-h2 mb-md">Where operations start to break</h2>
  <p class="text-muted max-w-2xl mb-lg">
    Select a problem to see how we intervene, and the result.
  </p>
  <Explorer client:visible idPrefix="solves" label="Operational problems" items={items} />
</Section>