---
import Section from '../Section.astro';

const faqs = [
  {
    id: 'faq-1',
    question: 'What kinds of operational problems do we work on?',
    paragraphs: [
      'Manual, slow, or unreliable work that lives across disconnected systems and individual knowledge.',
      'Common starting points include disconnected systems, heavy manual data handling, slow or inaccurate reporting, unreliable inventory signals, and processes that stall on exceptions or handoffs.',
    ],
  },
  {
    id: 'faq-2',
    question: 'Can we work with our existing software and systems?',
    paragraphs: [
      'Yes. We work across existing software, databases, spreadsheets, APIs, reporting systems, and internal workflows. Replacing systems is not the default.',
      'We choose the simplest intervention that produces the required outcome.',
    ],
  },
  {
    id: 'faq-3',
    question: 'How do you decide what should be automated?',
    paragraphs: [
      'We automate when a workflow has a meaningful business consequence and enough repeatability or operational burden to justify it.',
      'We evaluate the process, systems, data, exceptions, risks, and expected outcome first. Some problems need software, some need process changes, and some should not be automated at all.',
    ],
  },
  {
    id: 'faq-4',
    question: 'What happens when we first talk?',
    paragraphs: [
      'We start with how the work actually gets done today: where it breaks or slows down, and what the outcome needs to be.',
      'From there we explain how we would approach it, what a practical path forward looks like, and whether a focused paid Diagnostic is useful before scoping the build.',
    ],
  },
];
---

<Section variant="brand" id="faq" container="narrow">
  <div class="section-label">
    <span class="section-label__mark" aria-hidden="true"></span>
    <span class="section-label__text text-white">FAQ</span>
  </div>
  <h2 class="text-h2 mb-md">Common questions</h2>
  <p class="text-white/80 mb-lg">
    What working with us looks like.
  </p>

  <div class="divide-y divide-white/20 border-y border-white/20">
    {faqs.map((faq) => (
      <div class="py-md" data-faq-item>
        <button
          type="button"
          id={`${faq.id}-button`}
          aria-expanded="false"
          aria-controls={`${faq.id}-panel`}
          class="flex w-full items-center justify-between gap-md rounded-sm py-xs text-left text-body font-semibold text-white transition-colors duration-fast hover:text-brand-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white"
        >
          <span>{faq.question}</span>
          <span aria-hidden="true" class="shrink-0 text-lg text-brand-100">+</span>
        </button>
        <div id={`${faq.id}-panel`} role="region" aria-labelledby={`${faq.id}-button`} hidden>
          <div class="pt-sm">
            {faq.paragraphs.map((paragraph) => (
              <p class="text-body text-white/80 mb-sm">{paragraph}</p>
            ))}
            {faq.list && (
              <ul class="list-disc pl-md mb-sm space-y-xs">
                {faq.list.map((item) => (
                  <li class="text-body text-white/80">{item}</li>
                ))}
              </ul>
            )}
          </div>
        </div>
      </div>
    ))}
  </div>
</Section>

<script>
  document.querySelectorAll('[data-faq-item]').forEach((item) => {
    const button = item.querySelector('button[aria-expanded]');
    const panel = item.querySelector('[role="region"]');
    const indicator = button.querySelector('[aria-hidden="true"]');

    button.addEventListener('click', () => {
      const expanded = button.getAttribute('aria-expanded') === 'true';
      button.setAttribute('aria-expanded', String(!expanded));
      panel.hidden = expanded;
      indicator.textContent = expanded ? '+' : '\u2212';
    });
  });
</script>