---
import Section from '../Section.astro';

const sources = [
  'Spreadsheets',
  'ERP',
  'POS',
  'Email',
  'Existing software',
];

const actions = ['Connect', 'Automate', 'Surface'];

const outcomes = [
  'Better visibility',
  'Less manual work',
  'Fewer handoffs',
  'Faster decisions',
  'More capacity',
];
---

<Section variant="texture-1" id="how-we-work" label="How We Work">
  <h2 class="text-h2 mb-md max-w-3xl">Systems that grow with your operation</h2>
  <p class="text-muted max-w-2xl mb-lg">
    Your data, workflows, software, and decisions should work together.
    <br />
    We identify where the operation is losing time, visibility, or control, then connect the pieces that matter.
  </p>

  <div
    class="grid grid-cols-1 lg:grid-cols-[1fr_2.25rem_1fr_2.25rem_1fr] gap-x-md gap-y-sm lg:gap-x-sm lg:gap-y-0 lg:items-stretch"
  >
    <!-- Your systems -->
    <div class="flex flex-col gap-sm">
      <h3 class="text-sm font-semibold uppercase tracking-wider text-muted">Your systems</h3>
      <ul class="list-none p-0 m-0 flex flex-col gap-xs">
        {sources.map((source) => (
          <li class="flex items-center gap-xs rounded-lg border border-text/10 bg-white/70 px-sm py-xs">
            <span aria-hidden="true" class="h-2 w-2 shrink-0 rounded-full bg-text/30"></span>
            <span class="text-sm font-medium text-text">{source}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Connector -->
    <div class="flex items-center justify-center text-brand/70" aria-hidden="true">
      <svg class="hidden lg:block h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 12h15"></path>
        <path d="m13 6 6 6-6 6"></path>
      </svg>
      <svg class="lg:hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 4v15"></path>
        <path d="m6 13 6 6 6-6"></path>
      </svg>
    </div>

    <!-- What we do -->
    <div class="flex flex-col gap-sm">
      <h3 class="text-sm font-semibold uppercase tracking-wider text-brand">What we do</h3>
      <ul class="list-none p-0 m-0 flex flex-col gap-xs">
        {actions.map((action) => (
          <li class="flex items-center gap-xs rounded-lg border border-brand/20 bg-white/80 px-sm py-xs">
            <span aria-hidden="true" class="h-2 w-2 shrink-0 rounded-full bg-brand"></span>
            <span class="text-sm font-semibold text-text">{action}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Connector -->
    <div class="flex items-center justify-center text-brand/70" aria-hidden="true">
      <svg class="hidden lg:block h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 12h15"></path>
        <path d="m13 6 6 6-6 6"></path>
      </svg>
      <svg class="lg:hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 4v15"></path>
        <path d="m6 13 6 6 6-6"></path>
      </svg>
    </div>

    <!-- What changes -->
    <div class="flex flex-col gap-sm">
      <h3 class="text-sm font-semibold uppercase tracking-wider text-brand">What changes</h3>
      <ul class="list-none p-0 m-0 flex flex-col gap-xs">
        {outcomes.map((outcome) => (
          <li class="flex items-center gap-xs rounded-lg border border-brand/20 bg-white/80 px-sm py-xs">
            <span aria-hidden="true" class="font-semibold text-brand">&rarr;</span>
            <span class="text-sm font-medium text-text">{outcome}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Section>