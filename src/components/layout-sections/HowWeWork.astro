---
import Section from '../Section.astro';
import Explorer from './Explorer.svelte';

const items = [
  {
    id: 'your-systems',
    label: 'Your Systems',
    visual: 'unification',
    description: 'Spreadsheets, ERP, POS, email, and existing software — the systems you already run.',
  },
  {
    id: 'what-we-do',
    label: 'What We Do',
    visual: 'automation',
    description: 'Connect, automate, and surface the work that matters across your systems.',
  },
  {
    id: 'what-changes',
    label: 'What Changes',
    visual: 'dashboards',
    description: 'Better visibility, less manual work, fewer handoffs, and faster decisions.',
    note: 'More capacity for the work that matters.',
  },
];
---

<Section variant="texture-1" id="how-we-work" label="How We Work">
  <h2 class="text-h2 mb-md max-w-3xl">Systems That Grow With Your Operations</h2>
  <p class="text-muted max-w-2xl mb-lg">
    Your data, workflows, software, and decisions should work together.
    <br />
    We identify where the operation is losing time, visibility, or control, then connect the pieces that matter.
  </p>

  <Explorer client:visible idPrefix="how-we-work" label="How We Work" items={items} />
</Section>