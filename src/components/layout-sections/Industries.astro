---
import Section from '../Section.astro';

const industries = [
  'Retail',
  'Distribution',
  'Wholesale',
  'Grocery',
  'Pharmacy',
  'Multi-location operations',
];
---

<Section variant="texture-2" id="industries">
  <h2 class="text-h2 mb-md">Industries</h2>
  <p class="text-muted max-w-2xl mb-lg">
    Placeholder body&nbsp;&mdash; initially focused on inventory-driven
    operations.
  </p>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-md">
    {industries.map((name) => (
      <div class="rounded-lg border border-text/10 bg-white/60 p-md">
        <p class="text-sm font-semibold">{name}</p>
      </div>
    ))}
  </div>
</Section>