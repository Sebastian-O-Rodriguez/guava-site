---
import Section from '../Section.astro';
import Button from '../Button.astro';

const industries = [
  {
    name: 'Retail',
    href: '/industries#retail',
    useCase: 'Inventory visibility, replenishment, reporting, and multi-location workflows.',
  },
  {
    name: 'Distribution',
    href: '/industries#distribution',
    useCase: 'Order flow, purchasing, warehouse visibility, and reconciliation.',
  },
  {
    name: 'Wholesale',
    href: '/industries#wholesale',
    useCase: 'Vendor data, pricing, reporting, and operational handoffs.',
  },
  {
    name: 'Pharmacy',
    href: '/industries#pharmacy',
    useCase:
      'Inventory visibility, shrinkage and expiry management, and regulatory automation — bringing new products to market faster across region-specific requirements.',
  },
  {
    name: 'Multi-location',
    href: '/industries#multi-location',
    useCase: 'Cross-location reporting, workflow consistency, exceptions, and operational visibility.',
  },
];
---

<Section variant="texture-2" id="industries" label="Industries">
  <h2 class="text-h2 mb-md max-w-3xl">Initially focused on inventory-driven operations.</h2>
  <p class="text-muted max-w-2xl mb-lg">
    We work across established businesses with meaningful operational
    complexity, but inventory-driven companies are an initial specialization.
  </p>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-md mb-lg">
    {industries.map((industry) => (
      <a
        href={industry.href}
        class="group flex flex-col gap-sm rounded-lg border border-text/10 bg-white/70 p-md transition-all duration-base hover:-translate-y-0.5 hover:border-brand/30 hover:shadow-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand"
      >
        <span class="flex items-center justify-between gap-sm">
          <span class="text-body font-semibold text-text">{industry.name}</span>
          <span aria-hidden="true" class="text-brand transition-transform duration-base group-hover:translate-x-0.5">&rarr;</span>
        </span>
        <span class="text-sm text-muted">{industry.useCase}</span>
      </a>
    ))}
  </div>

  <Button variant="primary" href="/contact">See How We Fit Your Operation</Button>
</Section>