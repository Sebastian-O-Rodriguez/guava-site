---
import Section from '../Section.astro';

const outcomes = [
  'Less manual work',
  'Better visibility',
  'More reliable systems',
  'Clearer decisions',
  'Fewer fragile handoffs',
  'Greater operating capacity',
];
---

<Section variant="white" id="why-guava">
  <h2 class="text-h2 mb-md">Why Guava</h2>
  <p class="text-muted max-w-2xl mb-lg">
    Technology should serve the business&nbsp;&mdash; not the other way around.
    Placeholder body.
  </p>
  <ul class="grid grid-cols-1 sm:grid-cols-2 gap-md max-w-3xl list-none p-0">
    {outcomes.map((item) => (
      <li class="text-sm text-muted">{item}</li>
    ))}
  </ul>
</Section>