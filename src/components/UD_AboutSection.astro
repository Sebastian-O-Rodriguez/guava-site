<section id="about" class="section-wrapper">
    <div class="container">
      <div class="content-container">
        <h1 class="section-header">About Us</h1>
        
        <p class="text-enhanced mb-md">We're a tech consultancy dedicated to helping businesses leverage technology for growth and innovation.</p>
        <p class="mb-md leading-normal">Our team of experts specializes in modern frameworks and technologies to deliver high-performance, scalable solutions that drive business success. We combine strategic thinking with technical excellence to create digital solutions that transform how our clients operate.</p>
        
        <div class="mt-lg">
          <h3 class="text-h3 font-medium mb-md">Our Approach</h3>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-md">
            <!-- Card components with consistent styling using global card class -->
            <div class="card">
              <strong class="block text-large font-semibold mb-xs">Client-Focused</strong>
              <p class="text-small leading-normal m-0">We prioritize understanding your unique business needs to deliver tailored solutions.</p>
            </div>
            <div class="card">
              <strong class="block text-large font-semibold mb-xs">Technical Excellence</strong>
              <p class="text-small leading-normal m-0">Our team stays at the forefront of technology to provide cutting-edge solutions.</p>
            </div>
            <div class="card">
              <strong class="block text-large font-semibold mb-xs">Collaborative Partnership</strong>
              <p class="text-small leading-normal m-0">We work alongside your team to ensure seamless integration and knowledge transfer.</p>
            </div>
          </div>
        </div>
        
        <div class="mt-xl">
          <div class="aspect-[2/1] bg-white/5 rounded-lg flex items-center justify-center text-large text-white/30 border-2 border-dashed border-white/10">
            <span>Company Image</span>
          </div>
        </div>
      </div>
    </div>
  </section>