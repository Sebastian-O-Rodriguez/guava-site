---
---

<section id="competency" class="section-wrapper">
    <div class="container">
      <div class="content-container">
        <h1 class="section-header">We Understand Your Struggles</h1>
        <p class="text-enhanced mb-lg">With our expertise, navigating technology becomes simple and effective.</p>
        
        <div class="mt-lg">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-lg max-w-4xl mx-auto">
            <!-- Experience Card -->
            <div class="text-center">
              <h3 class="text-lg font-bold mb-sm">5+ Years of Tech Experience</h3>
              <p class="text-base leading-normal">Our team excels with machine learning and advanced tech solutions.</p>
            </div>
            
            <!-- Projects Card -->
            <div class="text-center">
              <h3 class="text-lg font-bold mb-sm">Over 100 Successful Tech Projects Delivered</h3>
              <p class="text-base leading-normal">Helping businesses navigate tech with proven results and growth.</p>
            </div>
          </div>
        </div>
        
        <!-- Testimonial Section -->
        <div class="mt-xl text-center max-w-3xl mx-auto">
          <p class="text-lg font-semibold mb-sm">Guava transformed our tech processes and streamlined our growth.</p>
          <p class="text-base">Alex Johnson, Business Owner</p>
        </div>
        
        <!-- CTA Button -->
        <div class="mt-xl flex justify-center">
          <button 
            class="btn btn-primary"
            data-cal-link="guavatt/30min"
            data-cal-namespace="30min"
            data-cal-config='{"layout":"month_view","theme":"light"}'
          >
            Schedule a Call
          </button>
      </div>
    </div>
  </section>