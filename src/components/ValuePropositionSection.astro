<section id="value-proposition" class="section-wrapper">
    <div class="container">
      <div class="content-container">
        <h1 class="section-header">Transform Your Business Operations</h1>
        <p class="text-enhanced mb-md">Gain simplied, powerful tech solutions tailored for your growth.</p>
        
        <div class="mt-lg">
          <div class="flex flex-wrap gap-md max-w-full mx-auto">
            <!-- Card components with consistent styling using global card class -->
            <div class="card">
              <p class="text-md leading-normal m-0">Set up an online storefront</p>
            </div>
            <div class="card">
              <p class="text-md leading-normal m-0">Help ads reach your target audience</p>
            </div>
            <div class="card">
              <p class="text-md leading-normal m-0">Turn your ideas into custom-built apps or tools</p>
            </div>
            <div class="card">
              <p class="text-md leading-normal m-0">Train your team to effectively use leading industry software</p>
            </div>
            <div class="card">
              <p class="text-md leading-normal m-0">Automate routine tasks to save time and cut costs</p>
            </div>
            <div class="card">
              <p class="text-md leading-normal m-0">Set up dashboards to see your numbers in real time</p>
            </div>
            <div class="card">
              <p class="text-md leading-normal m-0">Provide machine learning–powered insights to grow your business</p>
            </div>
            <div class="card">
              <p class="text-md leading-normal m-0">Migrate files and systems securely to the cloud</p>
            </div>
            <div class="card">
              <p class="text-md leading-normal m-0">Improve internal communication with smarter tools</p>
            </div>
            <div class="card">
              <p class="text-md leading-normal m-0">Keep customer data safe with strong security practices</p>
            </div>
            <div class="card">
              <p class="text-md leading-normal m-0">Design smooth onboarding experiences for your clients</p>
            </div>
            <div class="card">
              <p class="text-md leading-normal m-0">Connect and sync all your business tools in one place</p>
            </div>
          </div>
        </div>
        <div class="mt-xl flex justify-center">
            <button 
              class="btn btn-secondary"
              data-cal-link="guavatt/30min"
              data-cal-namespace="30min"
              data-cal-config='{"layout":"month_view","theme":"light"}'
            >
              Schedule a Call
            </button>
        </div>
      </div>
    </div>
  </section>