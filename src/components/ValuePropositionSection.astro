<section id="value-proposition" class="section-wrapper">
    <div class="container">
      <div class="content-container">
        <h1 class="section-header">Transform Your Business Operations</h1>
        <p class="text-enhanced mb-md">Gain simplied, powerful tech solutions tailored for your growth.</p>
        
        <div class="mt-lg">
          <div class="grid grid-cols-1 gap-md max-w-2xl mx-auto">
            <!-- Card components with consistent styling using global card class -->
            <div class="card">
              <p class="text-md leading-normal m-0">Expert guidance through technology choices</p>
            </div>
            <div class="card">
              <p class="text-md leading-normal m-0">Customized tech solutions designed for your needs</p>
            </div>
            <div class="card">
              <p class="text-md leading-normal m-0">Ongoing support and training for your team</p>
            </div>
            <div class="card">
              <p class="text-md leading-normal m-0">Measurable improvements in efficiency and growth</p>
            </div>
          </div>
        </div>
        <div class="mt-xl flex justify-center">
            <button 
              class="btn btn-primary"
              data-cal-link="guavatt/30min"
              data-cal-namespace="30min"
              data-cal-config='{"layout":"month_view","theme":"light"}'
            >
              Schedule a Call
            </button>
        </div>
      </div>
    </div>
  </section>