<section id="services" class="section-wrapper">
  <div class="container">
    <div class="content-container">
      <h1 class="section-header">Our Services</h1>
    
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-md mt-lg">
        <div class="card h-full flex flex-col">
          <div class="flex items-center justify-center w-20 h-20 bg-white/10 rounded-full mb-md">
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="16 18 22 12 16 6"></polyline>
              <polyline points="8 6 2 12 8 18"></polyline>
            </svg>
          </div>
          <h3 class="text-large font-semibold mb-sm">Custom Software Development</h3>
          <p class="leading-normal">We design and build bespoke software solutions tailored to your specific business needs, from web applications to enterprise systems.</p>
        </div>
        
        <div class="card h-full flex flex-col">
          <div class="flex items-center justify-center w-20 h-20 bg-white/10 rounded-full mb-md">
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
              <path d="M2 17l10 5 10-5"></path>
              <path d="M2 12l10 5 10-5"></path>
            </svg>
          </div>
          <h3 class="text-large font-semibold mb-sm">Cloud Solutions</h3>
          <p class="leading-normal">Leverage the power of cloud technology with our migration, optimization, and management services to enhance scalability and reduce costs.</p>
        </div>
        
        <div class="card h-full flex flex-col">
          <div class="flex items-center justify-center w-20 h-20 bg-white/10 rounded-full mb-md">
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="16" x2="12" y2="12"></line>
              <line x1="12" y1="8" x2="12.01" y2="8"></line>
            </svg>
          </div>
          <h3 class="text-large font-semibold mb-sm">Technology Consulting</h3>
          <p class="leading-normal">Our expert consultants provide strategic guidance to help you make informed decisions about technology investments and digital transformation.</p>
        </div>
        
        <div class="card h-full flex flex-col">
          <div class="flex items-center justify-center w-20 h-20 bg-white/10 rounded-full mb-md">
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
              <line x1="8" y1="21" x2="16" y2="21"></line>
              <line x1="12" y1="17" x2="12" y2="21"></line>
            </svg>
          </div>
          <h3 class="text-large font-semibold mb-sm">UI/UX Design</h3>
          <p class="leading-normal">Create intuitive, engaging user experiences with our design services that balance aesthetic appeal with functional usability.</p>
        </div>
        
        <div class="card h-full flex flex-col">
          <div class="flex items-center justify-center w-20 h-20 bg-white/10 rounded-full mb-md">
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
          </div>
          <h3 class="text-large font-semibold mb-sm">Tech Team Augmentation</h3>
          <p class="leading-normal">Enhance your development capabilities with our skilled professionals who seamlessly integrate with your existing team.</p>
        </div>
        
        <div class="card h-full flex flex-col">
          <div class="flex items-center justify-center w-20 h-20 bg-white/10 rounded-full mb-md">
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
          </div>
          <h3 class="text-large font-semibold mb-sm">Maintenance & Support</h3>
          <p class="leading-normal">Ensure your systems run smoothly with our comprehensive maintenance and support services, providing peace of mind and minimizing downtime.</p>
        </div>
      </div>
    </div>
  </div>
</section>