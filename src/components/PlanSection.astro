---
---

<section id="plan" class="section-wrapper">
  <div class="container">
    <div class="content-container">
      <h1 class="section-header">3 Simple Steps to Upgrade Your Tech</h1>
      <p class="text-enhanced mb-lg">Experience seamless growth with our structured approach.</p>
      
      <div class="mt-lg">
        <div class="grid grid-cols-1 gap-md max-w-2xl mx-auto">
          <!-- Step 1 Card -->
          <div class="card text-center">
            <h3 class="text-lg font-bold mb-sm">Schedule a Call</h3>
            <p class="text-base leading-normal">Let's discuss your technology needs.</p>
          </div>
          
          <!-- Step 2 Card -->
          <div class="card text-center">
            <h3 class="text-lg font-bold mb-sm">Identify Growth Areas</h3>
            <p class="text-base leading-normal">Pinpoint where tech can make the biggest impact.</p>
          </div>
          
          <!-- Step 3 Card -->
          <div class="card text-center">
            <h3 class="text-lg font-bold mb-sm">Agree on Project Scope</h3>
            <p class="text-base leading-normal">Define the project to fit your goals and budget.</p>
          </div>
        </div>
      </div>
      
      <!-- CTA Button -->
      <div class="mt-xl flex justify-center">
          <button 
            class="btn btn-primary"
            data-cal-link="guavatt/30min"
            data-cal-namespace="30min"
            data-cal-config='{"layout":"month_view","theme":"light"}'
          >
            Schedule a Call
          </button>
      </div>
    </div>
  </div>
</section>