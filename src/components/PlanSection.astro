---
---

<section id="plan" class="section-wrapper">
  <div class="container">
    <div class="content-container">
      <h1 class="section-header">Transform Your Business One Smart Step at a Time</h1>
      <p class="text-enhanced mb-lg">Start with a free consultation, then move at your own pace with our expert support.</p>
      
      <div class="mt-lg text-center">
        <div class="flex flex-wrap gap-md max-w-md mx-auto">
          <!-- Step 1 Card -->
          <div class="card w-full">
            <h3 class="text-lg font-bold mb-sm">Book Your Free Consult</h3>
            <p class="text-base leading-normal">Align on goals, fit, and key challenges.</p>
          </div>
          
          <!-- Step 2 Card -->
          <div class="card w-full">
            <h3 class="text-lg font-bold mb-sm">Deep Dive Discovery</h3>
            <p class="text-base leading-normal">Map your operations and build a clear tech roadmap.</p>
          </div>
          
          <!-- Step 3 Card -->
          <div class="card w-full">
            <h3 class="text-lg font-bold mb-sm">Deliver Real Results</h3>
            <p class="text-base leading-normal">Implement solutions to boost efficiency and spark growth.</p>
          </div>
        </div>
      </div>
      
      <!-- CTA Button -->
      <div class="mt-xl flex justify-center">
          <button
            class="btn btn-secondary"
            data-cal-link="guavatt/30min"
            data-cal-namespace="30min"
            data-cal-config='{"layout":"month_view","theme":"light"}'
          >
            Schedule a Call
          </button>
      </div>
    </div>
  </div>
</section>