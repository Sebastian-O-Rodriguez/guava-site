---
interface Props {
  /** Visual variant; primary = brand dark green */
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost';
  /** When set, renders an anchor instead of a button */
  href?: string;
  type?: 'button' | 'submit';
  class?: string;
}

const {
  variant = 'primary',
  href,
  type = 'button',
  class: className = '',
} = Astro.props;

const classes = ['btn', `btn-${variant}`, className].filter(Boolean).join(' ');
---

{href ? (
  <a href={href} class={classes}><slot /></a>
) : (
  <button type={type} class={classes}><slot /></button>
)}