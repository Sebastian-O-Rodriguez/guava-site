---
import SecondaryLayout from '../layouts/SecondaryLayout.astro';
import Button from '../components/Button.astro';

const title = 'Insights — Guava AI';
const description =
  'Thinking and observations from Guava\u2019s work with operational teams.';
---

<SecondaryLayout {title} {description}>
  <section class="section-band section-band--white">
    <div class="container">
      <h1 class="text-h1 mb-md max-w-3xl">Insights</h1>
      <p class="text-large text-muted max-w-2xl mb-lg">
        Observations from Guava's work with operational teams — including what
        we're learning about where technology genuinely helps, and where the
        simplest change is still the best one.
      </p>
      <Button variant="primary" href="/book-a-demo">Book a Demo</Button>
    </div>
  </section>
</SecondaryLayout>
