---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout-sections/Header.astro';
import Hero from '../components/layout-sections/Hero.astro';
import ProofSection from '../components/layout-sections/ProofSection.astro';
import HowWeWork from '../components/layout-sections/HowWeWork.astro';
import CapabilityExplorer from '../components/layout-sections/CapabilityExplorer.astro';
import CurrentWedges from '../components/layout-sections/CurrentWedges.astro';
import Industries from '../components/layout-sections/Industries.astro';
import CTABand from '../components/CTABand.astro';
import Motion from '../components/layout-sections/Motion.astro';

const title = 'Guava AI | Building Smarter Operations';
const description =
  'We connect data, workflows, and software into practical operating systems that reduce manual work, improve visibility, and give your team more room to grow.';
---

<Layout {title} {description}>
  <Header />
  <Hero />
  <ProofSection />
  <HowWeWork />
  <CapabilityExplorer />
  <CurrentWedges />
  <Industries />
  <CTABand
    variant="brand"
    title="Technology Should Make the Business Easier to Run"
    description="If manual work, disconnected systems, stale reports, or slow approvals are limiting the business, we help you determine what should change and build the systems that fix it."
    ctaLabel="Talk to Guava"
    ctaHref="/book-a-demo"
  />

  <Motion />
</Layout>
