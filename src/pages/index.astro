---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout-sections/Header.astro';
import Hero from '../components/layout-sections/Hero.astro';
import ProofSection from '../components/layout-sections/ProofSection.astro';
import HowWeWork from '../components/layout-sections/HowWeWork.astro';
import CapabilityExplorer from '../components/layout-sections/CapabilityExplorer.astro';
import Capabilities from '../components/layout-sections/Capabilities.astro';
import CtaTalkOperation from '../components/layout-sections/CtaTalkOperation.astro';
import WhatGuavaSolves from '../components/layout-sections/WhatGuavaSolves.astro';
import CurrentWedges from '../components/layout-sections/CurrentWedges.astro';
import Industries from '../components/layout-sections/Industries.astro';
import WhyGuava from '../components/layout-sections/WhyGuava.astro';
import LatestInsights from '../components/layout-sections/LatestInsights.astro';
import Faq from '../components/layout-sections/Faq.astro';
import FinalCta from '../components/layout-sections/FinalCta.astro';
import Engagement from '../components/layout-sections/Engagement.astro';
import Footer from '../components/layout-sections/Footer.astro';
import Newsletter from '../components/layout-sections/Newsletter.astro';
import Motion from '../components/layout-sections/Motion.astro';

const title = 'Guava AI — Building smarter operations';
const description =
  'We connect data, workflows, and software into practical operating systems that reduce manual work, improve visibility, and give your team more room to grow.';
---

<Layout {title} {description}>
  <Header />
  <Hero />
  <ProofSection />
  <HowWeWork />
  <Capabilities />
  <CapabilityExplorer />
  <CtaTalkOperation />
  <WhatGuavaSolves />
  <CurrentWedges />
  <Industries />
  <WhyGuava />
  <LatestInsights />
  <Faq />
  <Engagement />
  <FinalCta />
  <Newsletter />
  <Footer />

  <Motion />
</Layout>
