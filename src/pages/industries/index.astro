---
import SecondaryLayout from '../../layouts/SecondaryLayout.astro';
import Section from '../../components/Section.astro';
import CTABand from '../../components/CTABand.astro';

const title = 'Industries | Guava AI';
const description =
  'We work with established businesses where inventory, systems, and operational workflows have become difficult to manage by hand. Retail, distribution, wholesale, grocery, pharmacy, and multi-location operations.';

const industries = [
  {
    id: 'retail',
    name: 'Retail',
    description:
      'Keep inventory, replenishment, reporting, and store operations aligned across locations. We connect the systems behind the work so teams spend less time reconciling numbers and more time acting on them.',
  },
  {
    id: 'distribution',
    name: 'Distribution',
    description:
      'Orders, purchasing, warehouse activity, inventory, and reporting all depend on one another. We connect those workflows and automate repetitive handoffs, reconciliation, and reporting.',
  },
  {
    id: 'wholesale',
    name: 'Wholesale',
    description:
      'Keep vendor data, pricing, inventory, orders, and reporting consistent across the systems your team already uses. Manual updates and recurring reconciliation move into dependable workflows.',
  },
  {
    id: 'grocery',
    name: 'Grocery',
    description:
      'Fast-moving inventory leaves little room for stale reporting or disconnected systems. We improve visibility across locations, replenishment, inventory movement, and recurring exceptions.',
  },
  {
    id: 'pharmacy',
    name: 'Pharmacy',
    description:
      'Bring inventory, expiry, shrinkage, reporting, and regulatory workflows into a clearer operating system. Routine work becomes easier to track, automate, and escalate when a person needs to decide.',
  },
  {
    id: 'multi-location',
    name: 'Multi-Location',
    description:
      'Give every location consistent workflows and shared visibility without forcing every team into more manual reporting. Exceptions surface clearly while routine work stays standardized.',
  },
];
---

<SecondaryLayout {title} {description}>
  <Section variant="white" id="hero">
    <h1 class="text-h1 mb-md max-w-3xl [text-wrap:balance]">Industries</h1>
    <p class="text-large text-muted max-w-2xl">
      We work with established businesses where inventory, systems, and
      operational workflows have become difficult to manage by hand.
    </p>
    <p class="text-body text-muted max-w-2xl mb-lg">
      Different operations create different bottlenecks. We build around the
      systems, workflows, inventory, and decisions your team handles every day.
    </p>
  </Section>

  <Section variant="texture-1" id="industries" label="Industries We Serve">
    <h2 class="text-h2 mb-md max-w-3xl [text-wrap:balance]">
      Built Around How Your Operation Works
    </h2>
    <p class="text-muted max-w-2xl mb-lg">
      The details change by industry. The goal does not: less manual work,
      better visibility, and systems your team can rely on. We automate routine
      work while keeping judgment with your team.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-md">
      {industries.map((industry) => (
        <article
          id={industry.id}
          class="flex flex-col gap-sm scroll-mt-24 rounded-lg border border-text/10 bg-white/70 p-md"
        >
          <h3 class="text-h3">{industry.name}</h3>
          <p class="text-sm text-muted">{industry.description}</p>
        </article>
      ))}
    </div>
  </Section>

  <CTABand
    variant="brand"
    title="Technology Should Fit the Way Your Operation Works"
    ctaLabel="Talk to Guava"
    ctaHref="/book-a-demo"
  />
</SecondaryLayout>
