---
import SecondaryLayout from '../../layouts/SecondaryLayout.astro';
import Button from '../../components/Button.astro';

const title = 'Distribution — Guava AI';
const description =
  'Operational technology for distribution businesses moving inventory with accuracy and speed.';
---

<SecondaryLayout {title} {description}>
  <section class="section-band section-band--white">
    <div class="container">
      <h1 class="text-h1 mb-md max-w-3xl">Distribution</h1>
      <p class="text-large text-muted max-w-2xl mb-lg">
        Distribution lives or dies on accurate, current inventory and the
        ability to match records across systems. Guava helps distribution teams
        automate the reconciliation and data movement that currently eat the day.
      </p>
      <Button variant="primary" href="/book-a-demo">Book a Demo</Button>
    </div>
  </section>
</SecondaryLayout>
