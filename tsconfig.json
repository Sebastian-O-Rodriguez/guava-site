{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "strictNullChecks": true,
    "allowJs": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": [
      "three",
      "svelte"
    ]
  },
  "include": [
    ".astro/types.d.ts", 
    "src/**/*"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}